APP_NAME="Research Paper Assistant"
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/research_assistant

STORAGE_DIR=/app/storage

# --- LLM provider selection ---
# One of: openai | groq | gemini | openrouter | ollama
LLM_PROVIDER=groq

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Ingestion ---
UNSTRUCTURED_STRATEGY=fast
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=120

# --- Retrieval ---
RETRIEVAL_TOP_K=8
